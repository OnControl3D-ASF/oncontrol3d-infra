# Per-environment edge settings, read by render.sh and platform.yml. No secrets here (public repo).
NAMESPACE=oncontrol
# One variable drives LB annotation, Certificate, Host() rules and ConfigMap `edge` (E7): <label>.<location>.cloudapp.azure.com
DNS_LABEL=oc3d-asf-dev
AZURE_LOCATION=brazilsouth
# Start on staging; after `kubectl wait certificate/edge-tls` succeeds change to letsencrypt-prod (step 2.7).
CERT_ISSUER=letsencrypt-staging
