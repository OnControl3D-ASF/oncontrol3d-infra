# Pinned versions of the edge platform. Bump here, nowhere else (validate.sh and platform.yml read this file).
# Verified 2026-11-21 with `helm search repo` after `helm repo update` (see docs/edge.md "Versions").
TRAEFIK_CHART_REPO=https://traefik.github.io/charts
TRAEFIK_CHART_VERSION=42.4.1       # app v3.7.19
CERT_MANAGER_CHART_REPO=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION=v1.21.3
# Kubernetes version used by kubeconform to pick the built-in object schemas.
KUBERNETES_SCHEMA_VERSION=1.34.0
# Orthanc (third-party). Digest of the multi-arch manifest list for 26.9.1, read from the Docker Hub
# registry API on 2026-11-21; the tag is kept only for humans.
ORTHANC_IMAGE=orthancteam/orthanc:26.9.1@sha256:d2705f2c56547e55ce9bc2250fd22d05d326493b3f3d9fa191ecb7db8ca6b5a2
